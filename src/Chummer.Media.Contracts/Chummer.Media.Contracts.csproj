<Project Sdk="Microsoft.NET.Sdk"
         TreatAsLocalProperty="ChummerMediaApprovedPackageLicenseExpression">

  <PropertyGroup>
    <PackageId>Chummer.Media.Contracts</PackageId>
    <AssemblyName>Chummer.Media.Contracts</AssemblyName>
    <RootNamespace>Chummer.Media.Contracts</RootNamespace>
    <Description>Canonical render-verified media job and asset lifecycle contracts for Chummer media-factory.</Description>
    <PackageTags>chummer;media;contracts;render-verified;dto</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ArchonMegalon/chummer6-media-factory.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ChummerMediaPackagePublishing Condition="'$(ChummerMediaPackagePublishing)' == ''">false</ChummerMediaPackagePublishing>
    <!-- Owner-controlled policy. A reviewed change must set this before packages can exist. -->
    <ChummerMediaApprovedPackageLicenseExpression></ChummerMediaApprovedPackageLicenseExpression>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <IsPackable Condition="'$(ChummerMediaPackagePublishing)' == 'true' and '$(ChummerMediaApprovedPackageLicenseExpression)' != ''">true</IsPackable>
    <PackageLicenseExpression Condition="'$(ChummerMediaPackagePublishing)' == 'true' and '$(ChummerMediaApprovedPackageLicenseExpression)' != ''">$(ChummerMediaApprovedPackageLicenseExpression)</PackageLicenseExpression>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="RequireApprovedMediaPackageLicense" BeforeTargets="PrepareForBuild;GenerateNuspec;Pack"
          Condition="'$(IsPackable)' == 'true' or '$(ChummerMediaPackagePublishing)' == 'true'">
    <Error Condition="'$(IsPackable)' == 'true' and '$(ChummerMediaPackagePublishing)' != 'true'"
           Text="Chummer.Media.Contracts IsPackable=true is blocked without explicit ChummerMediaPackagePublishing=true authorization." />
    <Error Condition="'$(ChummerMediaApprovedPackageLicenseExpression)' == ''"
           Text="Chummer.Media.Contracts publication is blocked until an approved license expression is checked into the owner-controlled package policy." />
  </Target>

</Project>
