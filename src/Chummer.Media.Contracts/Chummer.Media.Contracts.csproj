<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Chummer.Media.Contracts</PackageId>
    <AssemblyName>Chummer.Media.Contracts</AssemblyName>
    <RootNamespace>Chummer.Media.Contracts</RootNamespace>
    <Description>Canonical render-verified media job and asset lifecycle contracts for Chummer media-factory.</Description>
    <PackageTags>chummer;media;contracts;render-verified;dto</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ArchonMegalon/chummer6-media-factory.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ChummerMediaPackagePublishing Condition="'$(ChummerMediaPackagePublishing)' == ''">false</ChummerMediaPackagePublishing>
    <IsPackable>$(ChummerMediaPackagePublishing)</IsPackable>
    <PackageLicenseExpression Condition="'$(ChummerMediaPackagePublishing)' == 'true'">$(ChummerMediaPackageLicenseExpression)</PackageLicenseExpression>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="RequireApprovedMediaPackageLicense" BeforeTargets="PrepareForBuild;GenerateNuspec;Pack"
          Condition="'$(ChummerMediaPackagePublishing)' == 'true'">
    <Error Condition="'$(ChummerMediaPackageLicenseExpression)' == ''"
           Text="Chummer.Media.Contracts publication is blocked until the owner supplies ChummerMediaPackageLicenseExpression and explicitly enables ChummerMediaPackagePublishing=true." />
  </Target>

</Project>
